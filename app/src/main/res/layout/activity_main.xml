<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/akuma_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AKUMA STREAM CLUB"
                android:textColor="@color/akuma_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="⚙"
                android:textColor="@color/akuma_text"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Kick + Twitch • fallback inteligente"
            android:textColor="@color/akuma_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/live_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_live"
                    android:paddingLeft="12dp"
                    android:paddingTop="6dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/live_now"
                    android:textColor="@color/akuma_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/platform_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/bg_chip"
                    android:paddingLeft="12dp"
                    android:paddingTop="6dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="6dp"
                    android:text="KICK"
                    android:textColor="@color/kick_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/channel_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@danilostorm"
                android:textColor="@color/akuma_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/status_checking"
                android:textColor="@color/akuma_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/player_shell"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:clipToOutline="true">

            <WebView
                android:id="@+id/player_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/audio_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_live"
                android:gravity="center"
                android:text="A"
                android:textColor="@color/akuma_text"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/audio_mode"
                android:textColor="@color/akuma_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/background_audio"
                android:textColor="@color/akuma_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_video"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_live"
            android:text="@string/video_mode"
            android:textAllCaps="false"
            android:textColor="@color/akuma_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/platform_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_auto"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:text="@string/platform_auto"
                android:textColor="@color/akuma_text"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_kick"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:text="@string/platform_kick"
                android:textColor="@color/kick_green"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_twitch"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:text="@string/platform_twitch"
                android:textColor="@color/twitch_purple"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip"
            android:text="@string/refresh"
            android:textAllCaps="false"
            android:textColor="@color/akuma_muted" />

    </LinearLayout>
</ScrollView>
